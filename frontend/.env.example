# Salin file ini menjadi .env.local atau .env di folder frontend/
# lalu isi dengan URL dan Anon Key dari Project Settings -> API di dashboard Supabase Anda.
# Jika dikosongkan, aplikasi otomatis berjalan dalam Mode Fallback (LocalStorage + Data Bawaan).

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
